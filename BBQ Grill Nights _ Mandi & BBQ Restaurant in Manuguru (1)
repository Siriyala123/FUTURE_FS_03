button, input, textarea, select { font: inherit; }

button, a { -webkit-tap-highlight-color: transparent; }

a { color: inherit; text-decoration: none; }

::selection { color: rgb(255, 247, 232); background: rgba(229, 102, 44, 0.35); }

:focus-visible { outline: 2px solid hsl(var(--secondary)); outline-offset: 4px; }

.serif { font-family: var(--app-font-serif); }

.mono { font-family: var(--app-font-mono); }

.eyebrow { color: hsl(var(--secondary)); font-family: var(--app-font-mono); letter-spacing: 0.17em; text-transform: uppercase; font-size: 0.67rem; }

.container-bbq { width: min(1160px, 100% - 40px); margin: 0px auto; }

.section-pad { padding: 105px 0px; }

.section-dark { background: rgb(33, 19, 15); }

.section-deep { background: rgb(20, 12, 10); }

.texture { position: relative; overflow: hidden; }

.texture::after { content: ""; opacity: 0.055; pointer-events: none; mix-blend-mode: screen; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.95' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.6'/%3E%3C/svg%3E"); position: absolute; inset: 0px; }

.reveal { animation: 0.8s ease 0s 1 normal both running rise-in; }

.reveal-delay-1 { animation-delay: 0.12s; }

.reveal-delay-2 { animation-delay: 0.22s; }

.reveal-delay-3 { animation-delay: 0.32s; }

@keyframes rise-in { 
  0% { opacity: 0; transform: translateY(22px); }
  100% { opacity: 1; transform: translateY(0px); }
}

@keyframes ember-pulse { 
  0%, 100% { opacity: 0.65; transform: scale(1); }
  50% { opacity: 0.9; transform: scale(1.06); }
}

@keyframes scroll-line { 
  0% { transform-origin: center top; transform: scaleY(0); }
  100% { transform-origin: center top; transform: scaleY(1); }
}

.ember-orb { animation: 5s ease-in-out 0s infinite normal none running ember-pulse; }

.scroll-line { animation: 1.8s ease-out 0s infinite alternate none running scroll-line; }

.hero { background: linear-gradient(90deg, rgba(18, 9, 7, 0.94), rgba(18, 9, 7, 0.72), rgba(18, 9, 7, 0.26) 76%, rgba(18, 9, 7, 0.6)), linear-gradient(rgba(0, 0, 0, 0) 69%, rgb(25, 16, 13)), url("https://images.pexels.com/photos/410648/pexels-photo-410648.jpeg?auto=compress&cs=tinysrgb&w=1800") 50% center / cover; min-height: min(850px, 100svh); }

.glass { backdrop-filter: blur(14px); background: rgba(42, 25, 18, 0.72); border: 1px solid rgba(246, 191, 113, 0.16); }

